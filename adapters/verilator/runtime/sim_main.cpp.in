// GPUFuzz generated Verilator testbench.
//
// Regenerated by adapters/verilator/gen.py for every target; do not edit.
// It drives one test case (kernel image + launch configuration + event
// conditions) through the RTL model and writes a JSONL trace that
// adapters/trace turns into the oracle's O = <A, E, S>.
#include <cinttypes>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>

#include "V{{TOP}}.h"
#include "gpufuzz_rt.h"

using namespace gpufuzz;

// ---------------------------------------------------------------------------
// signal map (generated from adapters/signals/{{TARGET}}.json)
// ---------------------------------------------------------------------------
struct SigDesc { const char* id; const char* path; int width; };
static const SigDesc kSignals[] = {
{{SIGNALS}}
};

struct StateDesc { const char* sid; const char* path; const char* obj_fmt; int obj_sig; int width; };
static const StateDesc kStates[] = {
{{STATES}}
};

struct InjectDesc { const char* ev; const char* method; const char* path; int value; int cycles; };
static const InjectDesc kInjects[] = {
{{INJECTS}}
};

static const char* kClockPath = "{{CLOCK}}";
static const char* kResetPath = "{{RESET}}";
static const int   kResetLevel = {{RESET_LEVEL}};
static const int   kResetCycles = {{RESET_CYCLES}};
static const char* kDonePath = "{{DONE}}";
static const char* kRetirePath = "{{RETIRE}}";
static const char* kStorePath = "{{STORE}}";
static const char* kTopName = "{{TOP}}";
static const char* kTargetName = "{{TARGET}}";
static const int   kMemKind = {{MEM_KIND}};      // 0 none, 1 simple, 2 axil, 3 axi4
static const uint64_t kMemBase = {{MEM_BASE}};
static const uint64_t kMemSize = {{MEM_SIZE}};
static const char* kPins[] = {
{{PINS}}
};

enum MemKind { MEM_NONE = 0, MEM_SIMPLE = 1, MEM_AXIL = 2, MEM_AXI4 = 3 };

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------
static SignalRef g_sig_at[128];
static std::vector<SigDesc> g_sigs;
static std::vector<uint64_t> g_last;
static std::vector<std::string> g_unresolved;

static std::vector<std::string> split(const std::string& s, char sep) {
    std::vector<std::string> out;
    size_t start = 0;
    while (true) {
        const size_t pos = s.find(sep, start);
        if (pos == std::string::npos) { out.push_back(s.substr(start)); break; }
        out.push_back(s.substr(start, pos - start));
        start = pos + 1;
    }
    return out;
}

static int sig_id(const std::string& id) {
    for (size_t i = 0; i < g_sigs.size(); ++i)
        if (id == g_sigs[i].id) return (int)i;
    return -1;
}

// ---------------------------------------------------------------------------
// event injector
// ---------------------------------------------------------------------------
struct Condition {
    std::string ev;
    std::string anchor;
    long start = 0;
    long hold = 0;
    long after = 0;
    long line = -1;
    long level = 0;
    long offset = 0;
    bool done = false;
    uint64_t t0 = 0;
    bool active = false;
};

static std::vector<Condition> g_conds;

static long param_long(const std::string& params, const std::string& key, long dflt) {
    for (const auto& kv : split(params, ',')) {
        const auto eq = kv.find('=');
        if (eq == std::string::npos) continue;
        if (kv.substr(0, eq) == key) return std::atol(kv.c_str() + eq + 1);
    }
    return dflt;
}

static void parse_event(const std::string& spec) {
    // ev:anchor:k=v,k=v
    const auto parts = split(spec, ':');
    Condition c;
    c.ev = parts.size() > 0 ? parts[0] : "";
    c.anchor = parts.size() > 1 ? parts[1] : "kernel_start";
    const std::string params = parts.size() > 2 ? parts[2] : "";
    c.start = param_long(params, "start", 0);
    c.hold = param_long(params, "hold", 0);
    c.after = param_long(params, "after", 0);
    c.line = param_long(params, "line", -1);
    c.level = param_long(params, "level", 0);
    c.offset = param_long(params, "offset", 0);
    g_conds.push_back(c);
}

// ---------------------------------------------------------------------------
// memory interface
// ---------------------------------------------------------------------------
static MemModel g_mem;
static bool g_mem_pending_write = false;
static uint64_t g_mem_aw_addr = 0;
static uint64_t g_mem_w_data = 0;
static uint64_t g_mem_w_strb = 0xff;
static bool g_mem_pending_read = false;
static uint64_t g_mem_ar_addr = 0;
static uint64_t g_bp_until = 0;

static bool backpressured(uint64_t cycle) { return cycle < g_bp_until; }

static void set_pin(int idx, uint64_t value) {
    if (idx >= 0 && (size_t)idx < sizeof(g_sig_at) / sizeof(g_sig_at[0]))
        write_var(g_sig_at[idx].var, value);
}

static uint64_t get_pin(int idx) {
    if (idx >= 0 && (size_t)idx < sizeof(g_sig_at) / sizeof(g_sig_at[0]))
        return read_var(g_sig_at[idx].var);
    return 0;
}

// pin indices follow kPins[] order emitted by gen.py
enum Pin {
{{PIN_ENUM}}
};

static void mem_tick(uint64_t cycle) {
    if (backpressured(cycle)) {
        set_pin(PIN_RREADY, 0);
        set_pin(PIN_AWREADY, 0);
        set_pin(PIN_ARREADY, 0);
        set_pin(PIN_WREADY, 0);
        return;
    }
    if (kMemKind == MEM_SIMPLE) {
        set_pin(PIN_REQ_READY, 1);
        if (get_pin(PIN_REQ_VALID)) {
            const uint64_t addr = get_pin(PIN_REQ_ADDR);
            if (get_pin(PIN_REQ_WE)) {
                g_mem.write(addr, get_pin(PIN_REQ_WDATA), 4, 0xf);
                set_pin(PIN_RSP_VALID, 1);
            } else {
                set_pin(PIN_RSP_RDATA, g_mem.read32(addr));
                set_pin(PIN_RSP_VALID, 1);
            }
        } else {
            set_pin(PIN_RSP_VALID, 0);
        }
        return;
    }
    if (kMemKind == MEM_NONE) return;

    // AXI-Lite / AXI4 (write address + write data + response, read address + data)
    set_pin(PIN_AWREADY, 1);
    set_pin(PIN_WREADY, 1);
    set_pin(PIN_ARREADY, 1);
    if (get_pin(PIN_AWVALID)) g_mem_aw_addr = get_pin(PIN_AWADDR);
    if (get_pin(PIN_WVALID)) {
        g_mem_w_data = get_pin(PIN_WDATA);
        g_mem_w_strb = (kMemKind == MEM_AXI4) ? get_pin(PIN_WSTRB) : 0xfu;
        g_mem_pending_write = true;
    }
    if (g_mem_pending_write) {
        g_mem.write(g_mem_aw_addr, g_mem_w_data, 4, g_mem_w_strb);
        g_mem_pending_write = false;
        set_pin(PIN_BVALID, 1);
        set_pin(PIN_BRESP, 0);
    } else if (get_pin(PIN_BREADY)) {
        set_pin(PIN_BVALID, 0);
    }
    if (get_pin(PIN_ARVALID)) {
        g_mem_ar_addr = get_pin(PIN_ARADDR);
        g_mem_pending_read = true;
    }
    if (g_mem_pending_read) {
        set_pin(PIN_RDATA, g_mem.read32(g_mem_ar_addr));
        set_pin(PIN_RLAST, 1);
        set_pin(PIN_RVALID, 1);
        g_mem_pending_read = false;
    } else if (get_pin(PIN_RREADY)) {
        set_pin(PIN_RVALID, 0);
    }
}

// ---------------------------------------------------------------------------
int main(int argc, char** argv) {
    std::string kernel, trace_path, test_id = "tc", cfg_events;
    uint64_t max_cycles = 300000;
    uint64_t code_base = 0;
    std::vector<std::pair<uint64_t, uint64_t>> gmem_init;
    std::vector<int> launch_args;

    for (int i = 1; i < argc; ++i) {
        const std::string a = argv[i];
        const std::string v = (i + 1 < argc) ? argv[i + 1] : "";
        if (a == "--kernel") { kernel = v; ++i; }
        else if (a == "--trace") { trace_path = v; ++i; }
        else if (a == "--test-id") { test_id = v; ++i; }
        else if (a == "--max-cycles") { max_cycles = std::strtoull(v.c_str(), nullptr, 0); ++i; }
        else if (a == "--code-base") { code_base = std::strtoull(v.c_str(), nullptr, 0); ++i; }
        else if (a == "--gmem") {
            const auto eq = v.find(':');
            if (eq != std::string::npos)
                gmem_init.push_back({std::strtoull(v.substr(0, eq).c_str(), nullptr, 0),
                                     std::strtoull(v.c_str() + eq + 1, nullptr, 0)});
            ++i;
        } else if (a == "--launch-arg") { launch_args.push_back(std::atoi(v.c_str())); ++i; }
        else if (a == "--event") { parse_event(v); ++i; }
        else { std::fprintf(stderr, "gpufuzz sim: unknown option %s\n", a.c_str()); }
    }
    if (kernel.empty()) { std::fprintf(stderr, "gpufuzz sim: --kernel is required\n"); return 2; }
    if (trace_path.empty()) trace_path = "trace.jsonl";

    Verilated::commandArgs(argc, argv);
    V{{TOP}}* top = new V{{TOP}};
    VerilatedContext* ctx = Verilated::threadContextp();

    // ---- resolve the signal map ---------------------------------------
    g_sigs.assign(std::begin(kSignals), std::end(kSignals));
    g_last.assign(g_sigs.size(), 0);
    for (size_t i = 0; i < g_sigs.size(); ++i) {
        VerilatedScope* scope = nullptr;
        VerilatedVar* var = resolve_var(ctx->model(), g_sigs[i].path, &scope);
        g_sig_at[i].path = g_sigs[i].path;
        g_sig_at[i].var = var;
        g_sig_at[i].scope = scope;
        if (!var) g_unresolved.push_back(g_sigs[i].path);
    }

    TraceWriter tw;
    if (!tw.open(trace_path)) {
        std::fprintf(stderr, "gpufuzz sim: cannot open %s\n", trace_path.c_str());
        return 2;
    }
    tw.header(kTargetName, kTopName, test_id, g_unresolved);

    // ---- reset ---------------------------------------------------------
    top->{{CLOCK_MEMBER}} = 0;
    top->{{RESET_MEMBER}} = kResetLevel;
    top->eval();
    for (int c = 0; c < kResetCycles; ++c) {
        top->{{CLOCK_MEMBER}} = 1; top->eval();
        top->{{CLOCK_MEMBER}} = 0; top->eval();
    }
    top->{{RESET_MEMBER}} = kResetLevel ^ 1;
    top->eval();

    // ---- memory image --------------------------------------------------
    g_mem.load_image(kernel, code_base);
    for (const auto& kv : gmem_init) g_mem.write(kv.first, kv.second, 4, 0xf);

    SignalRef done_ref, retire_ref, store_ref;
    done_ref.var = resolve_var(ctx->model(), kDonePath, nullptr);
    retire_ref.var = resolve_var(ctx->model(), kRetirePath, nullptr);
    store_ref.var = resolve_var(ctx->model(), kStorePath, nullptr);

    uint64_t cycle = 0;
    uint64_t retire_count = 0, store_count = 0;
    bool done = false;

    for (; cycle < max_cycles; ++cycle) {
        top->{{CLOCK_MEMBER}} = 1;
        top->eval();

        // ---- sample signals (delta) ------------------------------------
        std::vector<std::pair<int, uint64_t>> changed;
        for (size_t i = 0; i < g_sigs.size(); ++i) {
            const uint64_t v = read_var(g_sig_at[i].var);
            if (v != g_last[i]) { g_last[i] = v; changed.push_back({(int)i, v}); }
        }
        tw.signals(cycle, changed);

        // ---- state elements -------------------------------------------
        for (const auto& sd : kStates) {
            VerilatedVar* var = resolve_var(ctx->model(), sd.path, nullptr);
            if (!var) continue;
            const uint64_t val = read_var(var);
            unsigned long obj_id = 0;
            if (sd.obj_sig >= 0) obj_id = (unsigned long)read_var(g_sig_at[sd.obj_sig].var);
            char obj[128];
            std::snprintf(obj, sizeof(obj), sd.obj_fmt, obj_id);
            tw.state(cycle, sd.sid, obj, val, sd.path);
        }

        // ---- injected events ------------------------------------------
        if (retire_ref.var && read_var(retire_ref.var)) ++retire_count;
        if (store_ref.var && read_var(store_ref.var)) ++store_count;
        for (auto& c : g_conds) {
            if (c.done) continue;
            bool fire = false;
            if (c.anchor == "kernel_start") fire = (cycle >= (uint64_t)c.start);
            else if (c.anchor == "after_retire") fire = (retire_count > (uint64_t)c.after);
            else if (c.anchor == "after_store") fire = (store_count > (uint64_t)c.after);
            else if (c.anchor == "after_issue") fire = (retire_count > (uint64_t)c.after);
            else if (c.anchor == "when_dirty" || c.anchor == "when_pending_wb")
                fire = (cycle > kResetCycles + 8);   // refined by the trace analysis
            if (!fire) continue;
            c.done = true;
            c.t0 = cycle;
            if (c.ev == "mem_backpressure") {
                g_bp_until = cycle + (uint64_t)c.hold + 1;
                tw.event(cycle, "mem_stall", "line:bp", "stalled");
            } else {
                for (const auto& inj : kInjects) {
                    if (c.ev != inj.ev) continue;
                    if (std::strcmp(inj.method, "drive") == 0) {
                        for (const auto& p : split(inj.path, '|')) {
                            const int idx = sig_id(p);
                            if (idx >= 0) set_pin(idx, (uint64_t)inj.value);
                        }
                    } else if (std::strcmp(inj.method, "pulse") == 0) {
                        const int idx = sig_id(inj.path);
                        if (idx >= 0) {
                            set_pin(idx, 1);
                            tw.event(cycle, "flush", "line:inject", "ok");
                        }
                    }
                }
            }
        }
        // release pulses after one cycle
        for (const auto& inj : kInjects) {
            if (std::strcmp(inj.method, "pulse") != 0) continue;
            for (auto& c : g_conds) {
                if (c.done && c.t0 + 1 == cycle && c.ev != "mem_backpressure") {
                    const int idx = sig_id(inj.path);
                    if (idx >= 0) set_pin(idx, 0);
                }
            }
        }

        mem_tick(cycle);

        top->{{CLOCK_MEMBER}} = 0;
        top->eval();

        if (done_ref.var && read_var(done_ref.var)) { done = true; ++cycle; break; }
    }

    // ---- architectural dump --------------------------------------------
    tw.arch_begin();
    bool first = true;
    for (const auto& kv : g_mem.words()) {
        tw.arch_mem(kv.first, kv.second, first);
        first = false;
    }
    tw.arch_end(cycle, done ? false : true, done ? 0 : 1);

    top->final();
    delete top;
    if (g_unresolved.size()) {
        std::fprintf(stderr, "gpufuzz sim: %zu unresolved signals (see trace header)\n",
                     g_unresolved.size());
        return 3;
    }
    return 0;
}
