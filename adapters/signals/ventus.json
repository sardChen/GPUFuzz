  "inject": {
    "mem_backpressure": {
      "method": "drive",
      "pins": [
        "mem_ready"
      ],
      "value": 0,
      "note": "drive the memory interface's ready/valid-low for the window"
    },
    "cache_flush": {
      "method": "pulse",
      "path": "flush_valid",
      "cycles": 1
    }
  },
  "arch": {
    "mem_range": [
      4096,
      69632
    ],
    "regfile": []
  },
  "progress": {
    "retire": "commit_valid",
    "store": "mem_valid"
  },
  "gaps": [
    "scoreboard busy vector width must match the number of architectural registers",
    "flush address signal is a line index in some builds; adjust obj_fmt"
  ],
  "notes": [
    "Every path is empty on purpose: run `python3 cli.py discover --target ventus --rtl <checkout>` to resolve the probes against your elaborated RTL, then `cli.py doctor`.",
